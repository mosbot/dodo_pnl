# Учётные данные приложения Dodo IS (кабинет разработчика / маркетплейс)
DODO_CLIENT_ID=your_client_id
DODO_CLIENT_SECRET=your_client_secret

# Scopes: openid + offline_access обязательны, остальные — по доменам API,
# которые выданы вашему приложению (см. настройки приложения в Dodo IS)
DODO_SCOPES=openid offline_access

# Страна по умолчанию (ru — Россия, hr — Хорватия для Загреба)
DODO_COUNTRY=ru

# UUID заведений по умолчанию, через запятую (получить: list_my_units)
DODO_UNITS=

# Необязательно: алиасы заведений, чтобы обращаться по названию города
# DODO_UNITS_ALIASES={"кубинка":"000d3a24...","тучково":"000d3a25...","протвино":"...","алексин":"..."}

# Redirect URI для первичной авторизации (зарегистрируйте в приложении)
DODO_REDIRECT_URI=http://localhost:8400/callback

# Транспорт MCP: stdio (Claude Desktop/Code) или http (custom connector claude.ai)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8788
MCP_PATH=/mcp
